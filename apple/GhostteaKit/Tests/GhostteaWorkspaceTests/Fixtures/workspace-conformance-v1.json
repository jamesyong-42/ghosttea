{
  "schemaVersion": 1,
  "scenarios": [
    {
      "name": "nested split focus resize zoom and close",
      "initial": {
        "version": 1,
        "root": { "kind": "pane", "id": "pane-1", "sessionId": "session-1" },
        "activePaneId": "pane-1",
        "zoomedPaneId": null
      },
      "steps": [
        {
          "action": {
            "type": "split",
            "axis": "horizontal",
            "paneId": "pane-2",
            "sessionId": "session-2",
            "splitId": "split-1"
          },
          "expected": {
            "document": {
              "version": 1,
              "root": {
                "kind": "split",
                "id": "split-1",
                "axis": "horizontal",
                "ratio": 0.5,
                "first": { "kind": "pane", "id": "pane-1", "sessionId": "session-1" },
                "second": { "kind": "pane", "id": "pane-2", "sessionId": "session-2" }
              },
              "activePaneId": "pane-2",
              "zoomedPaneId": null
            },
            "closedSessionId": null,
            "shouldCloseWindow": false
          }
        },
        {
          "action": {
            "type": "split",
            "axis": "vertical",
            "paneId": "pane-3",
            "sessionId": "session-3",
            "splitId": "split-2"
          },
          "expected": {
            "document": {
              "version": 1,
              "root": {
                "kind": "split",
                "id": "split-1",
                "axis": "horizontal",
