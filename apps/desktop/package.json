{
  "name": "ghosttea-demo",
  "version": "0.1.0",
  "description": "The Ghosttea desktop example application.",
  "author": "James Yong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesyong-42/ghosttea.git",
    "directory": "apps/desktop"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "stage:ghosttead": "node ../../scripts/stage-terminald.mjs",
    "dist": "npm run stage:ghosttead && npm run build && electron-builder",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vibecook/ghosttea": "0.1.0",
    "@vibecook/ghosttea-frame": "0.1.0",
    "@vibecook/ghosttea-protocol": "0.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@webgpu/types": "^0.1.71",
    "electron": "43.1.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
